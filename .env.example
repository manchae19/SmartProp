# Shared configuration. Docker Compose reads root .env automatically.
# Spring/Maven: from backend, dot-source .\scripts\load-env.ps1 before running.
DB_URL=jdbc:mysql://localhost:3306/smartprop?connectionTimeZone=UTC
DB_USER=smartprop
DB_PASSWORD=replace-with-your-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
JWT_SECRET=replace-with-random-secret-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPRING_PROFILES_ACTIVE=dev
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_DATABASE_SEED_ENABLED=false
DEV_DATABASE_SEED_PASSWORD=
# Default fixture path is relative to backend working directory.
DEV_DATABASE_SEED_FIXTURE=dev-fixtures/sample-property.svg
# Optional address lookup. Server keys only; never use VITE_ variables.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=GEOAPIFY
GEOAPIFY_API_KEY=
GEOCODING_GOOGLE_API_KEY=
