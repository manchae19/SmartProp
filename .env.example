# Shared configuration. Docker Compose reads root .env automatically.
# Spring/Maven: from backend, dot-source .\scripts\load-env.ps1 before running.
DB_URL=jdbc:mysql://localhost:3306/smartprop?connectionTimeZone=UTC
DB_USER=smartprop
DB_PASSWORD=replace-with-your-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
JWT_SECRET=replace-with-random-secret-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable publisher applications only after reviewing migration V13/schema.
BROKER_APPLICATIONS_ENABLED=false
SPRING_PROFILES_ACTIVE=dev
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Optional address lookup. Server keys only; never use VITE_ variables.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=GEOAPIFY
GEOAPIFY_API_KEY=
GEOCODING_GOOGLE_API_KEY=

# Phase 12G: optional real V1.3 dimensions. Keep false in production until approved.
SMARTPROP_V1_3_REAL_FEATURES=false

# Persistent sessions: enable only after V10/schema and origin review.
REFRESH_ENABLED=false
REFRESH_SECURE_COOKIE=true
ACCESS_TOKEN_MINUTES=15

# UI V4: enable only after approved V15 rollout.
PROFILE_AVATAR_ENABLED=false

# Google OIDC: configure a Web Application client after approved V15 rollout.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FRONTEND_ORIGIN=http://127.0.0.1:5173
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/oauth2/callback/google

# Cloudinary image storage (V17). Leave empty to use LOCAL storage under
# STORAGE_ROOT. See backend/.env.cloudinary.local.example for the full set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YOLOv8 object analysis (V22). Off by default: enabling it requires the V22
# migration to be applied and the vision service running on 18002.
APP_IMAGE_ANALYSIS_ENABLED=false
APP_IMAGE_ANALYSIS_BASE_URL=http://127.0.0.1:18002

# Auto-Scan duplicate detection (V21). The imagecheck service runs on 18001.
APP_IMAGE_SCAN_BASE_URL=http://127.0.0.1:18001

# Routing vendor for the trip to work.
#   OPENROUTESERVICE (HeiGIT) — one Matrix call ranks a shortlist; needs the key below.
#   GEOAPIFY — per-pair calls, reuses GEOAPIFY_API_KEY from above.
# Leave the key empty to keep the feature off; the advisor still searches by budget
# and simply reports that travel time is unavailable.
APP_ROUTING_PROVIDER=GEOAPIFY
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_URL=https://api.heigit.org/openrouteservice
