{
  "name": "smartprop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:e2e": "playwright test",
    "dev:admin": "npm --prefix admin-dashboard run dev -- --host 127.0.0.1 --port 5174 --strictPort",
