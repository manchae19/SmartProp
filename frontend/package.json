    "postinstall": "npm --prefix admin-dashboard ci"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "1.9.4",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.3"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
