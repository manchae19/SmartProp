# Browser key: enable Maps JavaScript API and Places API (New).
# Restrict the key to your website HTTP referrers and these two APIs.
# Put the actual value in .env.local; do not commit it or send it in chat.
VITE_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is for local development; use your own map ID for deployment.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Opt-in only after backend refresh flag + V10 + cookie/CORS origin review.
# Dev uses the fixed Vite /api proxy. Production needs a same-origin HTTPS reverse proxy.
VITE_ENABLE_REFRESH=false
VITE_API_BASE_URL=/api/v1

# Optional HTTPS raster tile provider for the manual posting map.
# Browser cache headers are respected; no offline download/prefetch.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
