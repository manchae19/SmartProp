# Copy to private /etc/smartprop/runtime.env. Never commit real values.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:mysql://127.0.0.1:3306/smartprop?connectionTimeZone=UTC
DB_USER=smartprop
DB_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://YOUR_DOMAIN
STORAGE_ROOT=/var/lib/smartprop/uploads
# Spring Boot 3.5.16 binds server.forward-headers-strategy via SERVER_FORWARD_HEADERS_STRATEGY.
# Only trust X-Forwarded-For / X-Forwarded-Proto from local loopback Caddy (never non-loopback peers).
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=127\.\d{1,3}\.\d{1,3}\.\d{1,3}|0:0:0:0:0:0:0:1|::1
# Public deployment keeps research & internal demo flags fail-closed (false).
APP_RECOMMENDATION_ALLOW_UNVERIFIED_EXTERNAL=false
APP_RECOMMENDATION_TINIX_ENABLED=false
APP_COMPARABLE_RESEARCH_ENABLED=false
APP_ADVISOR_ALLOW_RESEARCH_COMPARABLES=false
APP_MARKET_RESEARCH_ENABLED=false
RAG_LAND_ENABLED=false
RAG_LAND_DEMO_ENABLED=false
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
# For frontend build: VITE_API_BASE_URL=/api/v1
# Caddy reads SMARTPROP_DOMAIN from its own service environment, not this backend file.
