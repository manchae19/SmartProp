# Copy to private /etc/smartprop/runtime.env. Never commit real values.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://127.0.0.1:3306/smartprop?connectionTimeZone=UTC
DB_USER=smartprop
DB_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://YOUR_DOMAIN
STORAGE_ROOT=/var/lib/smartprop/uploads
SPRING_FORWARD_HEADERS_STRATEGY=framework
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
# For frontend build: VITE_API_BASE_URL=/api/v1
# Caddy reads SMARTPROP_DOMAIN from its own service environment, not this backend file.